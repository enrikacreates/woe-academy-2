# Form email delivery (set these in the Vercel project's Environment Variables).
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where booking and quote requests are sent. Comma-separate several addresses.
FORM_TO_EMAIL=connect@worldofexplorers.com
# Sender address; its domain must be verified in Resend.
FORM_FROM_EMAIL=World of Explorers <hello@worldofexplorers.com>
